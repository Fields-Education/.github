{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "description": "Renovate configuration for Fields-Education/.github.",
  "configMigration": true,
  "dependencyDashboard": true,
  "automerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "enabledManagers": ["github-actions", "mise"],
  "packageRules": [
    {
      "description": "Group routine GitHub Actions updates into one reviewable PR.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group routine mise tool updates into one reviewable PR.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    }
  ]
}
